{
  "custom": {
    "validation": {
      "isInvalid": false
    },
    "raw": null
  },
  "params": {
    "decimalAllowed": false,
    "enabled": true,
    "input": null,
    "inputFieldWidth": "150px",
    "label": "",
    "labelFieldWidth": "200px",
    "negativeAllowed": true,
    "placeholder": "Geef een waarde in...",
    "required": false,
    "validatedInput": null,
    "value": null
  },
  "propConfig": {
    "params.decimalAllowed": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.enabled": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.input": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.inputFieldWidth": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.label": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.labelFieldWidth": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.negativeAllowed": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.placeholder": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.required": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.validatedInput": {
      "binding": {
        "config": {
          "path": "view.params.input"
        },
        "type": "property"
      },
      "paramDirection": "output",
      "persistent": true
    },
    "params.value": {
      "paramDirection": "output",
      "persistent": true
    },
    "custom.validation.isInvalid": {
      "binding": {
        "config": {
          "path": "/root/ValueContainer/NumericField.props.text"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\tvalidation_result = common.validation.input.validateNumericInput(\n\t\tvalue,\n\t\tnegativeAllowed=self.params.negativeAllowed,\n\t\tdecimalAllowed=self.params.decimalAllowed,\n\t\trequired=self.params.required\n\t)\n\treturn len(validation_result.get('errorMessage', '')) > 0",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.raw": {
      "binding": {
        "type": "property",
        "config": {
          "path": "/root/ValueContainer/NumericField.props.text"
        }
      }
    }
  },
  "props": {
    "defaultSize": {
      "height": 68,
      "width": 633
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "NumericLabel"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "position.basis": {
            "binding": {
              "config": {
                "path": "view.params.labelFieldWidth"
              },
              "overlayOptOut": true,
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.label"
              },
              "overlayOptOut": true,
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "fontFamily": "Arial",
            "fontSize": 15,
            "fontWeight": "bold",
            "margin": 4,
            "textAlign": "right"
          }
        },
        "type": "ia.display.label"
      },
      {
        "children": [
          {
            "meta": {
              "name": "NumericField"
            },
            "position": {
              "basis": "40px",
              "shrink": 0
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "config": {
                    "path": "view.params.enabled"
                  },
                  "type": "property"
                }
              },
              "props.placeholder": {
                "binding": {
                  "config": {
                    "path": "view.params.placeholder"
                  },
                  "type": "property"
                }
              },
              "props.style.borderColor": {
                "binding": {
                  "config": {
                    "expression": "if({view.custom.validation.isInvalid}, '#d32f2f', '#c5c5c5')"
                  },
                  "type": "expr"
                }
              },
              "props.style.borderWidth": {
                "binding": {
                  "config": {
                    "expression": "if({view.custom.validation.isInvalid}, '2px', '1px')"
                  },
                  "type": "expr"
                }
              },
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.input"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "expression": "if(isNull({value}), \"\", {value})",
                      "type": "expression"
                    }
                  ],
                  "type": "property"
                },
                "onChange": {
                  "enabled": null,
                  "script": "\tvalue = currentValue.value\n\tvalidation_result = common.validation.input.validateNumericInput(\n\t\tvalue,\n\t\tnegativeAllowed=self.view.params.negativeAllowed,\n\t\tdecimalAllowed=self.view.params.decimalAllowed,\n\t\trequired=self.view.params.required\n\t)\n\tself.view.params.value = value\n\tself.view.params.validatedInput = common.validation.input.resolveValidatedInput(\n\t\tvalue,\n\t\tself.view.params.input,\n\t\tvalidation_result,\n\t\tblankValue=None\n\t)"
                }
              }
            },
            "props": {
              "deferUpdates": false,
              "style": {
                "borderStyle": "solid",
                "margin": "4px"
              }
            },
            "type": "ia.input.text-field"
          },
          {
            "meta": {
              "name": "NumericValidation"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "config": {
                    "path": "view.custom.validation.isInvalid"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "expression": "if(isNull({value}) || !{value}, false, true)",
                      "type": "expression"
                    }
                  ],
                  "type": "property"
                }
              },
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.custom.raw"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\tvalidation_result = common.validation.input.validateNumericInput(\n\t\tvalue,\n\t\tnegativeAllowed=self.view.params.negativeAllowed,\n\t\tdecimalAllowed=self.view.params.decimalAllowed,\n\t\trequired=self.view.params.required\n\t)\n\treturn validation_result.get('errorMessage', '')",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "color": "#d32f2f",
                "fontSize": "11px",
                "margin": "0 4px 0 4px"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "ValueContainer"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "position.basis": {
            "binding": {
              "config": {
                "path": "view.params.inputFieldWidth"
              },
              "overlayOptOut": true,
              "type": "property"
            }
          }
        },
        "props": {
          "direction": "column",
          "style": {
            "min-width": "100px",
            "overflow": "visible"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "wrap": "wrap"
    },
    "type": "ia.container.flex"
  }
}
