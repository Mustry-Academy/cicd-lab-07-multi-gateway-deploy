{
  "custom": {
    "validation": {
      "isInvalid": false
    }
  },
  "params": {
    "enabled": true,
    "input": null,
    "inputFieldWidth": "150px",
    "label": "",
    "labelFieldWidth": "200px",
    "required": false,
    "states": [],
    "validatedInput": null,
    "value": null
  },
  "propConfig": {
    "params.enabled": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.input": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.inputFieldWidth": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.label": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.labelFieldWidth": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.required": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.states": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.validatedInput": {
      "binding": {
        "config": {
          "path": "view.params.input"
        },
        "type": "property"
      },
      "paramDirection": "output",
      "persistent": true
    },
    "params.value": {
      "paramDirection": "output",
      "persistent": true
    },
    "custom.validation.isInvalid": {
      "binding": {
        "config": {
          "path": "/root/ValueContainer/MultiStateButton.props.controlValue"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\tvalidationResult = common.validation.input.validateDropdownInput(\n\t\tvalue,\n\t\trequired=self.params.required,\n\t\tallowedValues=[state.get('value') for state in self.params.states]\n\t)\n\treturn len(validationResult.get('errorMessage', '')) > 0",
            "type": "script"
          }
        ],
        "type": "property"
      }
    }
  },
  "props": {
    "defaultSize": {
      "height": 68,
      "width": 633
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "MultiStateLabel"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "position.basis": {
            "binding": {
              "config": {
                "path": "view.params.labelFieldWidth"
              },
              "overlayOptOut": true,
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.label"
              },
              "overlayOptOut": true,
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "fontFamily": "Arial",
            "fontSize": 15,
            "fontWeight": "bold",
            "margin": 4,
            "textAlign": "right"
          }
        },
        "type": "ia.display.label"
      },
      {
        "children": [
          {
            "meta": {
              "name": "MultiStateButton"
            },
            "position": {
              "basis": "40px",
              "shrink": 0
            },
            "propConfig": {
              "props.controlValue": {
                "binding": {
                  "config": {
                    "path": "view.params.input"
                  },
                  "overlayOptOut": true,
                  "type": "property"
                },
                "onChange": {
                  "enabled": null,
                  "script": "\tvalue = currentValue.value\n\tvalidationResult = common.validation.input.validateDropdownInput(\n\t\tvalue,\n\t\trequired=self.view.params.required,\n\t\tallowedValues=[state.get('value') for state in self.props.states]\n\t)\n\tself.view.params.value = value\n\tself.view.params.validatedInput = common.validation.input.resolveValidatedInput(\n\t\tvalue,\n\t\tself.view.params.input,\n\t\tvalidationResult,\n\t\tblankValue=None\n\t)"
                }
              },
              "props.enabled": {
                "binding": {
                  "config": {
                    "path": "view.params.enabled"
                  },
                  "type": "property"
                }
              },
              "props.indicatorValue": {
                "binding": {
                  "config": {
                    "path": "this.props.controlValue"
                  },
                  "overlayOptOut": true,
                  "type": "property"
                }
              },
              "props.states": {
                "binding": {
                  "config": {
                    "path": "view.params.states"
                  },
                  "overlayOptOut": true,
                  "type": "property"
                }
              },
              "props.style.borderColor": {
                "binding": {
                  "config": {
                    "expression": "if({view.custom.validation.isInvalid}, '#d32f2f', '#c5c5c5')"
                  },
                  "type": "expr"
                }
              },
              "props.style.borderStyle": {
                "binding": {
                  "config": {
                    "expression": "'solid'"
                  },
                  "type": "expr"
                }
              },
              "props.style.borderWidth": {
                "binding": {
                  "config": {
                    "expression": "if({view.custom.validation.isInvalid}, '2px', '1px')"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "defaultSelectedStyle": {
                "backgroundColor": "var(--callToAction)",
                "color": "var(--neutral-10)"
              },
              "orientation": "row",
              "style": {
                "margin": 4
              }
            },
            "type": "ia.input.multi-state-button"
          },
          {
            "meta": {
              "name": "MultiStateValidation"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "config": {
                    "path": "view.custom.validation.isInvalid"
                  },
                  "overlayOptOut": true,
                  "type": "property"
                }
              },
              "props.text": {
                "binding": {
                  "config": {
                    "path": "../MultiStateButton.props.controlValue"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\tvalidationResult = common.validation.input.validateDropdownInput(\n\t\tvalue,\n\t\trequired=self.view.params.required,\n\t\tallowedValues=[state.get('value') for state in self.parent.getChild('MultiStateButton').props.states]\n\t)\n\treturn validationResult.get('errorMessage', '')",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "color": "#d32f2f",
                "fontSize": "11px",
                "margin": "0 4px 0 4px"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "ValueContainer"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "position.basis": {
            "binding": {
              "config": {
                "path": "view.params.inputFieldWidth"
              },
              "overlayOptOut": true,
              "type": "property"
            }
          }
        },
        "props": {
          "direction": "column",
          "style": {
            "min-width": "100px",
            "overflow": "visible"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "wrap": "wrap"
    },
    "type": "ia.container.flex"
  }
}
