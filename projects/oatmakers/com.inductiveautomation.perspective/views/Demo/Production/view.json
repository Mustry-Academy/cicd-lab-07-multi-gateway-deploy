          "direction": "row",
          "wrap": "wrap",
          "useDefaultViewWidth": false,
          "useDefaultViewHeight": true,
          "elementPosition": {
            "basis": "230px",
            "grow": 1,
            "shrink": 0
          },
          "instances": [],
          "style": {
            "classes": "Demo/Repeater"
          }
        },
        "position": {
          "shrink": 0,
          "basis": "auto"
        },
        "propConfig": {
          "props.instances": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.custom.data.metrics"
              }
            }
          }
        }
