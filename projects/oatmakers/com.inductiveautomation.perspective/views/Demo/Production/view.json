            "position": {
              "shrink": 0,
              "basis": "auto"
            }
          },
          {
            "type": "ia.display.table",
            "meta": {
              "name": "Orders"
            },
            "props": {
              "data": [],
              "columns": [
                {
                  "field": "reference",
                  "visible": true,
                  "editable": false,
                  "render": "auto",
                  "header": {
                    "title": "Batch"
                  },
                  "width": 190,
                  "strictWidth": false
                },
                {
                  "field": "line",
                  "visible": true,
                  "editable": false,
                  "render": "auto",
                  "header": {
                    "title": "Production line"
                  },
                  "width": 170,
                  "strictWidth": false
                },
                {
                  "field": "product",
                  "visible": true,
                  "editable": false,
                  "render": "auto",
                  "header": {
                    "title": "Product"
                  },
                  "width": 150,
                  "strictWidth": false
                },
                {
                  "field": "started",
                  "visible": true,
                  "editable": false,
                  "render": "auto",
                  "header": {
                    "title": "Started"
                  },
                  "width": 140,
                  "strictWidth": false
                },
                {
                  "field": "produced_kg",
                  "visible": true,
                  "editable": false,
                  "render": "auto",
                  "header": {
                    "title": "Output kg"
                  },
                  "width": 115,
                  "strictWidth": false
                },
                {
                  "field": "target_kg",
                  "visible": true,
                  "editable": false,
                  "render": "auto",
                  "header": {
                    "title": "Target kg"
                  },
                  "width": 115,
                  "strictWidth": false
                },
                {
                  "field": "status",
                  "visible": true,
                  "editable": false,
                  "render": "auto",
                  "header": {
                    "title": "Status"
                  },
                  "width": 150,
                  "strictWidth": false
                }
              ],
              "pager": {
                "top": false,
                "bottom": true,
                "initialOption": 10,
                "options": [
                  10,
                  20,
                  50
                ]
              },
              "selection": {
                "enabled": true,
                "mode": "row"
              },
              "filter": {
                "enabled": true
              },
              "headerStyle": {
                "backgroundColor": "#edf2e8",
                "color": "#355541",
                "fontWeight": "600",
                "fontSize": 12
              },
              "rows": {
                "height": 36,
                "striped": {
                  "enabled": true,
                  "color": "#f7f9f4"
                }
              },
              "style": {
                "classes": "Demo/Table"
              }
            },
            "position": {
              "shrink": 0,
              "basis": "530px"
            },
            "propConfig": {
              "props.data": {
                "binding": {
                  "type": "property",
                  "config": {
                    "path": "view.custom.data.planning"
                  }
                }
              }
            },
            "events": {
              "component": {
                "onRowClick": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\trow = self.props.data[event.row]\n\tif row.get(\"status\") == \"Scheduled\":\n\t\tself.view.custom.selectionNotice = \"This batch is scheduled. Quality measurements become available after production starts.\"\n\t\treturn\n\tself.session.custom.demo.batch = row[\"reference\"]\n\tsystem.perspective.navigate(\"/quality\")"
                  }
                }
              }
            }
          }
        ],
        "position": {
          "shrink": 0,
          "grow": 0
        }
      },
