{
  "custom": {
    "live": {
      "ready": false,
      "metrics": [],
      "lines": [],
      "trend": [],
      "updatedEpochMs": 0,
      "updatedAt": "",
      "shiftStart": ""
    }
  },
  "params": {},
  "propConfig": {
    "custom.live": {
      "binding": {
        "type": "expr-struct",
        "config": {
          "waitOnAll": true,
          "struct": {
            "tick": "now(5000)"
          }
        },
        "transforms": [
          {
            "type": "script",
            "code": "\treturn application.demo.live()"
          }
        ]
      }
    }
  },
  "props": {
    "defaultSize": {
      "width": 1280,
      "height": 1000
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "Demo/Page Demo/ScadaPage"
      }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Header"
        },
        "props": {
          "direction": "row",
          "wrap": "wrap",
          "style": {
            "classes": "Demo/PageHeader"
          }
        },
        "children": [
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "Identity"
            },
            "props": {
              "direction": "column"
            },
            "children": [
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "Eyebrow"
                },
                "props": {
                  "text": "OATMAKERS / LIVE OPERATIONS",
                  "style": {
                    "classes": "Demo/Eyebrow"
                  }
                },
                "position": {
                  "shrink": 0,
                  "basis": "auto"
                }
              },
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "Title"
                },
                "props": {
                  "text": "SCADA",
                  "style": {
                    "classes": "Demo/PageTitle"
                  }
                },
                "position": {
                  "shrink": 0,
                  "basis": "auto"
                }
              },
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "Subtitle"
                },
                "props": {
                  "text": "Live process drawings with smooth navigation and tag history.",
                  "style": {
                    "classes": "Demo/Subtitle"
                  }
                },
                "position": {
                  "shrink": 0,
                  "basis": "auto"
                }
              }
            ],
            "position": {
              "shrink": 0,
              "grow": 1
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Mode"
            },
            "props": {
              "text": "SIMULATED FACTORY",
              "style": {
                "classes": "Demo/DemoBadge"
              }
            },
            "position": {
              "shrink": 0,
              "basis": "auto"
            }
          }
        ],
        "position": {
          "shrink": 0
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "LiveStatus"
        },
        "props": {
          "text": "",
          "style": {
            "classes": "Demo/LiveStatus"
          }
        },
        "position": {
          "shrink": 0,
          "basis": "auto"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.custom.live.ready}, \"Live \u00b7 recorded at \" + {view.custom.live.updatedAt} + \" \u00b7 updates every 5 seconds\", \"Live telemetry is unavailable\")"
              }
            }
          },
          "props.style.color": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.custom.live.ready}, \"#277b57\", \"#b66622\")"
              }
            }
          }
        }
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Controls"
        },
        "props": {
          "direction": "row",
          "wrap": "wrap",
          "style": {
            "classes": "Demo/Filters"
          }
        },
        "children": [
          {
            "type": "ia.input.dropdown",
            "meta": {
              "name": "Line"
            },
            "props": {
              "options": [
                {
                  "value": 1,
                  "label": "Rolling line 01"
                },
                {
                  "value": 2,
                  "label": "Cutting line 02"
                },
                {
                  "value": 3,
                  "label": "Milling line 03"
                }
              ],
              "value": 1,
              "search": {
                "enabled": false
              },
              "style": {
                "classes": "Demo/Select",
                "overflow": "visible"
              }
            },
            "position": {
              "shrink": 0,
              "basis": "200px"
            },
            "propConfig": {
              "props.value": {
                "binding": {
                  "type": "property",
                  "config": {
                    "path": "session.custom.demo.scadaLine",
                    "bidirectional": true
                  }
                }
              }
            }
          },
          {
            "type": "ia.input.dropdown",
            "meta": {
              "name": "Area"
            },
            "props": {
              "options": [
                {
                  "value": "peeling",
                  "label": "Peeling & conveying"
                },
                {
                  "value": "heating",
                  "label": "Heat treatment"
                }
              ],
              "value": "peeling",
              "search": {
                "enabled": false
              },
              "style": {
                "classes": "Demo/Select",
                "overflow": "visible"
              }
            },
            "position": {
              "shrink": 0,
              "basis": "200px"
            },
            "propConfig": {
              "props.value": {
                "binding": {
                  "type": "property",
                  "config": {
                    "path": "session.custom.demo.scadaArea",
                    "bidirectional": true
                  }
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Hint"
            },
            "props": {
              "text": "Drag to pan, wheel to zoom. Click a measurement for its history.",
              "style": {
                "classes": "Demo/Muted"
              }
            },
            "position": {
              "shrink": 0,
              "basis": "auto"
            }
          }
        ],
        "position": {
          "shrink": 0
        }
      },
      {
        "type": "mustrysolutions.perspective.display.panzoomview",
        "meta": {
          "name": "ScadaMap"
        },
        "props": {
          "config": {
            "viewPath": "Demo/ScadaViews/Peeling",
            "viewParams": [
              {
                "name": "lineNumber",
                "value": 1
              }
            ],
            "contentWidth": 0,
            "contentHeight": 0,
            "minZoom": 0.25,
            "maxZoom": 4,
            "showControls": true,
            "showMinimap": true,
            "showPoiList": true,
            "wheelZoom": true,
            "doubleClickZoom": true,
            "flyToMs": 350,
            "home": {
              "x": -1,
              "y": -1,
              "zoom": 0
            }
          },
          "data": {
            "pois": []
          },
          "style": {
            "classes": "Demo/ScadaMap",
            "minHeight": "480px"
          }
        },
        "position": {
          "shrink": 1,
          "basis": "0px",
          "grow": 1
        },
        "propConfig": {
          "props.config.viewPath": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({session.custom.demo.scadaArea} = \"heating\", \"Demo/ScadaViews/Heating\", \"Demo/ScadaViews/Peeling\")"
              }
            }
          },
          "props.config.viewParams[0].value": {
            "binding": {
              "type": "property",
              "config": {
                "path": "session.custom.demo.scadaLine"
              }
            }
          },
          "props.data.pois": {
            "binding": {
              "type": "property",
              "config": {
                "path": "session.custom.demo.scadaArea"
              },
              "transforms": [
                {
                  "type": "script",
                  "code": "\tif value == \"heating\":\n\t\treturn [{\"name\":\"Heater\", \"x\":500,\"y\":600,\"zoom\":1.1},{\"name\":\"Heat exchanger\",\"x\":850,\"y\":900,\"zoom\":1.4}]\n\treturn [{\"name\":\"Infeed\", \"x\":300,\"y\":150,\"zoom\":1.5},{\"name\":\"Peeling\", \"x\":580,\"y\":490,\"zoom\":1.3},\n\t\t{\"name\":\"Discharge\", \"x\":850,\"y\":710,\"zoom\":1.4}]"
                }
              ]
            }
          }
        }
      }
    ],
    "position": {
      "shrink": 0
    }
  }
}
