{
  "custom": {
    "data": {
      "ready": false,
      "stale": false,
      "message": "Loading demonstration data...",
      "metrics": [],
      "lines": [],
      "trend": [],
      "orders": [],
      "planning": [],
      "losses": [],
      "events": [],
      "quality": [],
      "batchOptions": [],
