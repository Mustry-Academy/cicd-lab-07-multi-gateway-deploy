{
  "custom": {
    "live": {
      "ready": false,
      "metrics": [],
      "lines": [],
      "trend": [],
      "updatedEpochMs": 0,
      "updatedAt": "",
      "shiftStart": ""
    },
    "values": {},
    "validation": {
      "valid": false,
      "message": ""
    },
    "requestId": "",
    "busy": false,
    "result": "",
    "requests": []
  },
  "params": {},
  "propConfig": {
    "custom.live": {
      "binding": {
        "type": "expr-struct",
        "config": {
          "waitOnAll": true,
          "struct": {
            "tick": "now(1000)"
          }
        },
        "transforms": [
          {
            "type": "script",
            "code": "\treturn application.demo.live()"
          }
        ]
      }
    },
    "custom.values": {
      "binding": {
        "type": "expr-struct",
        "config": {
          "waitOnAll": true,
          "struct": {
            "reference": "{/root/Workspace/Form/Reference.props.params.value}",
            "product": "{/root/Workspace/Form/Product.props.params.value}",
            "quantity": "{/root/Workspace/Form/Quantity.props.params.value}",
            "bags": "{/root/Workspace/Form/Bags.props.params.value}",
            "mode": "{/root/Workspace/Form/Mode.props.params.value}"
          }
        },
        "transforms": [
          {
            "type": "script",
            "code": "\treturn value"
          }
        ]
      },
      "onChange": {
        "enabled": true,
        "script": "\tself.custom.requestId = \"\""
      }
    },
    "custom.validation": {
      "binding": {
        "type": "property",
        "config": {
          "path": "view.custom.values"
        },
        "transforms": [
          {
            "type": "script",
            "code": "\treturn application.demo.validateOrder(value)"
          }
        ]
      }
    },
    "custom.requests": {
      "binding": {
        "type": "expr-struct",
        "config": {
          "waitOnAll": true,
          "struct": {
            "refresh": "now(5000)"
          }
        },
        "transforms": [
          {
            "type": "script",
            "code": "\treturn application.demo.recentOrders()"
          }
        ]
      }
    },
    "custom.requestId": {
      "persistent": true
    },
    "custom.busy": {
      "persistent": true
    },
    "custom.result": {
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 1280,
      "height": 1000
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "Demo/Page"
      }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Header"
        },
        "props": {
          "direction": "row",
          "wrap": "wrap",
          "style": {
            "classes": "Demo/PageHeader"
          }
        },
        "children": [
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "Identity"
            },
            "props": {
              "direction": "column"
            },
            "children": [
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "Eyebrow"
                },
                "props": {
                  "text": "OATMAKERS / LIVE OPERATIONS",
                  "style": {
                    "classes": "Demo/Eyebrow"
                  }
                },
                "position": {
                  "shrink": 0,
                  "basis": "auto"
                }
              },
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "Title"
                },
                "props": {
                  "text": "Production orders",
                  "style": {
                    "classes": "Demo/PageTitle"
                  }
                },
                "position": {
                  "shrink": 0,
                  "basis": "auto"
                }
              }
            ],
            "position": {
              "shrink": 0,
              "grow": 1
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Mode"
            },
            "props": {
              "text": "SIMULATED FACTORY",
              "style": {
                "classes": "Demo/DemoBadge"
              }
            },
            "position": {
              "shrink": 0,
              "basis": "auto"
            }
          }
        ],
        "position": {
          "shrink": 0
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "LiveStatus"
        },
        "props": {
          "text": "",
          "style": {
            "classes": "Demo/LiveStatus"
          }
        },
        "position": {
          "shrink": 0,
          "basis": "auto"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.custom.live.ready}, \"Live \u00b7 recorded at \" + {view.custom.live.updatedAt} + \" \u00b7 updates every second\", \"Live telemetry is unavailable\")"
              }
            }
          },
          "props.style.color": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.custom.live.ready}, \"#6d757c\", \"#b57a17\")"
              }
            }
          }
        }
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Workspace"
        },
        "props": {
          "direction": "row",
          "style": {
            "classes": "Demo/Workspace"
          }
        },
        "children": [
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "Form"
            },
            "props": {
              "direction": "column",
              "style": {
                "classes": "Demo/Panel",
                "overflow": "visible",
                "alignSelf": "flex-start"
              }
            },
            "children": [
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "FormTitle"
                },
                "props": {
                  "text": "New production order",
                  "style": {
                    "classes": "Demo/SectionTitle"
                  }
                },
                "position": {
                  "shrink": 0,
                  "basis": "auto"
                }
              },
              {
                "type": "ia.display.view",
                "meta": {
                  "name": "Reference"
                },
                "props": {
                  "path": "Templates/InputFields/TextInputField",
                  "params": {
                    "label": "Order number",
                    "labelFieldWidth": "130px",
                    "inputFieldWidth": "220px",
                    "input": "MO-001",
                    "value": "MO-001",
                    "validatedInput": "MO-001",
                    "required": true,
                    "enabled": true,
                    "placeholder": "Enter a value..."
                  },
                  "useDefaultViewWidth": false,
                  "useDefaultViewHeight": false,
                  "style": {
                    "overflow": "visible"
                  }
                },
                "position": {
                  "shrink": 0,
                  "basis": "66px"
                }
              },
              {
                "type": "ia.display.view",
                "meta": {
                  "name": "Product"
                },
                "props": {
                  "path": "Templates/InputFields/DropdownInputField",
                  "params": {
                    "label": "Product",
                    "labelFieldWidth": "130px",
                    "inputFieldWidth": "220px",
                    "input": "Rolled oats",
                    "value": "Rolled oats",
                    "validatedInput": "Rolled oats",
                    "required": true,
                    "enabled": true,
                    "placeholder": "Enter a value...",
                    "options": [
                      {
                        "label": "Rolled oats",
                        "value": "Rolled oats"
                      },
                      {
                        "label": "Steel-cut oats",
                        "value": "Steel-cut oats"
                      },
                      {
                        "label": "Oat flour",
                        "value": "Oat flour"
                      }
                    ]
                  },
                  "useDefaultViewWidth": false,
                  "useDefaultViewHeight": false,
                  "style": {
                    "overflow": "visible"
                  }
                },
                "position": {
                  "shrink": 0,
                  "basis": "66px"
                }
              },
              {
                "type": "ia.display.view",
                "meta": {
                  "name": "Quantity"
                },
                "props": {
                  "path": "Templates/InputFields/NumericInputField",
                  "params": {
                    "label": "Planned quantity (kg)",
                    "labelFieldWidth": "130px",
                    "inputFieldWidth": "220px",
                    "input": "1250.5",
                    "value": "1250.5",
                    "validatedInput": "1250.5",
                    "required": true,
                    "enabled": true,
                    "placeholder": "Enter a value...",
                    "decimalAllowed": true,
                    "negativeAllowed": false
                  },
                  "useDefaultViewWidth": false,
                  "useDefaultViewHeight": false,
                  "style": {
                    "overflow": "visible"
                  }
                },
                "position": {
                  "shrink": 0,
                  "basis": "66px"
                }
              },
              {
                "type": "ia.display.view",
                "meta": {
                  "name": "Bags"
                },
                "props": {
                  "path": "Templates/InputFields/NumericInputField",
                  "params": {
                    "label": "Planned bags",
                    "labelFieldWidth": "130px",
                    "inputFieldWidth": "220px",
                    "input": "50",
                    "value": "50",
                    "validatedInput": "50",
                    "required": true,
                    "enabled": true,
                    "placeholder": "Enter a value...",
                    "decimalAllowed": false,
                    "negativeAllowed": false
                  },
                  "useDefaultViewWidth": false,
                  "useDefaultViewHeight": false,
                  "style": {
                    "overflow": "visible"
                  }
                },
                "position": {
                  "shrink": 0,
                  "basis": "66px"
                }
              },
              {
                "type": "ia.display.view",
                "meta": {
                  "name": "Mode"
                },
                "props": {
                  "path": "Templates/InputFields/MultiStateInputField",
                  "params": {
                    "label": "Run mode",
                    "labelFieldWidth": "130px",
                    "inputFieldWidth": "220px",
                    "input": "Trial",
                    "value": "Trial",
                    "validatedInput": "Trial",
                    "required": true,
                    "enabled": true,
                    "placeholder": "Enter a value...",
                    "states": [
                      {
                        "value": "Trial",
                        "text": "Trial",
                        "selectedStyle": {
                          "classes": ""
                        },
                        "unselectedStyle": {
                          "classes": ""
                        }
                      },
                      {
                        "value": "Production",
                        "text": "Production",
                        "selectedStyle": {
                          "classes": ""
                        },
                        "unselectedStyle": {
                          "classes": ""
                        }
                      },
                      {
                        "value": "Hold",
                        "text": "Hold",
                        "selectedStyle": {
                          "classes": ""
                        },
                        "unselectedStyle": {
                          "classes": ""
                        }
                      }
                    ]
                  },
                  "useDefaultViewWidth": false,
                  "useDefaultViewHeight": false,
                  "style": {
                    "overflow": "visible"
                  }
                },
                "position": {
                  "shrink": 0,
                  "basis": "66px"
                }
              },
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "Validation"
                },
                "props": {
                  "text": "",
                  "style": {
                    "classes": "Demo/Muted"
                  }
                },
                "position": {
                  "shrink": 0,
                  "basis": "auto"
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "type": "property",
                      "config": {
                        "path": "view.custom.validation.message"
                      }
                    }
                  }
                }
              },
              {
                "type": "ia.input.button",
                "meta": {
                  "name": "Submit"
                },
                "props": {
                  "text": "Create order",
                  "style": {
                    "classes": "Demo/Button"
                  }
                },
                "position": {
                  "shrink": 0,
                  "basis": "40px"
                },
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "type": "script",
                      "scope": "G",
                      "config": {
                        "script": "\tif self.view.custom.busy:\n\t\treturn\n\tself.view.custom.busy = True\n\ttry:\n\t\tif not self.view.custom.requestId:\n\t\t\tself.view.custom.requestId = application.demo.newRequestId()\n\t\tself.view.custom.result = application.demo.createOrder(dict(self.view.custom.values),self.view.custom.requestId)\n\t\tself.view.refreshBinding(\"custom.requests\")\n\texcept (Exception, application.demo.JavaException):\n\t\tself.view.custom.result = \"Could not save the production order. Try again.\"\n\tfinally:\n\t\tself.view.custom.busy = False"
                      }
                    }
                  }
                },
                "propConfig": {
                  "props.enabled": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "{view.custom.validation.valid} && !{view.custom.busy} && {view.custom.live.ready}"
                      }
                    }
                  }
                }
              },
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "Result"
                },
                "props": {
                  "text": "",
                  "style": {
                    "classes": "Demo/Status"
                  }
                },
                "position": {
                  "shrink": 0,
                  "basis": "auto"
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "type": "property",
                      "config": {
                        "path": "view.custom.result"
                      }
                    }
                  }
                }
              }
            ],
            "position": {
              "shrink": 0,
              "basis": "450px",
              "grow": 0
            }
          },
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "RequestList"
            },
            "props": {
              "direction": "column",
              "style": {
                "classes": "Demo/Panel",
                "height": "calc(100vh - 215px)",
                "minHeight": "400px",
                "overflow": "hidden"
              }
            },
            "children": [
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "RequestListTitle"
                },
                "props": {
                  "text": "Order list",
                  "style": {
                    "classes": "Demo/SectionTitle"
                  }
                },
                "position": {
                  "shrink": 0,
                  "basis": "auto"
                }
              },
              {
                "type": "mustrysolutions.perspective.input.datagrid",
                "meta": {
                  "name": "Requests"
                },
                "props": {
                  "config": {
                    "columns": [
                      {
                        "field": "reference",
                        "header": "Order number",
                        "width": 190
                      },
                      {
                        "field": "product",
                        "header": "Product",
                        "width": 160
                      },
                      {
                        "field": "quantity_kg",
                        "header": "Quantity (kg)",
                        "width": 140,
                        "type": "number",
                        "align": "right",
                        "decimals": 1
                      },
                      {
                        "field": "bags",
                        "header": "Bags",
                        "width": 80,
                        "type": "number",
                        "align": "right",
                        "decimals": 0
                      },
                      {
                        "field": "mode",
                        "header": "Run mode",
                        "width": 110
                      },
                      {
                        "field": "submitted",
                        "header": "Created",
                        "width": 140
                      }
                    ],
                    "idField": "reference",
                    "rowHeight": 44,
                    "locale": "en-GB",
                    "rowSelect": "none",
                    "showToolbar": true,
                    "showExport": true,
                    "editable": false,
                    "emptyMessage": "No records for the selected range."
                  },
                  "data": {
                    "rows": []
                  },
                  "state": {
                    "selection": []
                  },
                  "style": {
                    "classes": "Demo/DataGrid"
                  }
                },
                "position": {
                  "basis": "0px",
                  "grow": 1,
                  "shrink": 1
                },
                "propConfig": {
                  "props.data.rows": {
                    "binding": {
                      "type": "property",
                      "config": {
                        "path": "view.custom.requests"
                      }
                    }
                  }
                }
              }
            ],
            "position": {
              "shrink": 0,
              "basis": "560px",
              "grow": 1
            }
          }
        ],
        "position": {
          "shrink": 0
        }
      }
    ],
    "position": {
      "shrink": 0
    }
  }
}
