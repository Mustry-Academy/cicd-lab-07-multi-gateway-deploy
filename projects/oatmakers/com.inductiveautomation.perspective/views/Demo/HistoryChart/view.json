{
  "custom": {
    "range": {
      "start": 0,
      "end": 0,
      "valid": false,
      "realtime": true
    },
    "history": {
      "points": [],
      "message": "Select a recorded range."
    }
  },
  "params": {
    "lineNumber": 0,
    "metric": "rate",
    "showSelectors": true,
    "range": {}
  },
  "propConfig": {
    "custom.range": {
      "binding": {
        "type": "expr-struct",
        "config": {
          "waitOnAll": true,
          "struct": {
            "start": "{/root/Controls/DateRange.props.output.startEpochMs}",
            "end": "{/root/Controls/DateRange.props.output.endEpochMs}",
            "valid": "{/root/Controls/DateRange.props.output.isValid}",
            "realtime": "{/root/Controls/DateRange.props.output.isRealtime}"
          }
        }
      }
    },
    "params.lineNumber": {
      "paramDirection": "inout",
      "persistent": true
    },
    "params.metric": {
      "paramDirection": "inout",
      "persistent": true
    },
    "params.range": {
      "binding": {
        "type": "property",
        "config": {
          "path": "view.custom.range"
        }
      },
      "paramDirection": "output"
    },
    "custom.history": {
      "binding": {
        "type": "expr-struct",
        "config": {
          "waitOnAll": true,
          "struct": {
            "range": "{view.custom.range}",
            "line": "{view.params.lineNumber}",
            "metric": "{view.params.metric}",
            "refresh": "now(5000)"
          }
        },
        "transforms": [
          {
            "type": "script",
            "code": "\treturn application.demo.history(value[\"range\"][\"start\"], value[\"range\"][\"end\"], value[\"line\"], value[\"metric\"])"
          }
        ]
      }
    },
    "params.showSelectors": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 1280,
      "height": 430
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "Demo/HistoryRoot"
      }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Controls"
        },
        "props": {
