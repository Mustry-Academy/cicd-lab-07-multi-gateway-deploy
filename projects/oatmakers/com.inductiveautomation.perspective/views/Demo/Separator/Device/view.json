{
  "custom": {},
  "params": {
    "tag": "PCV151A2",
    "source": "",
    "highlight": false,
    "signal": "pressure"
  },
  "propConfig": {
    "params.tag": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.source": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.highlight": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.signal": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 1280,
      "height": 95
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "Separator/Device"
      }
    },
    "children": [
      {
        "type": "ia.display.image",
        "meta": {
          "name": "Symbol"
        },
        "props": {
          "source": "data:image/svg+xml;base64,",
          "fit": {
            "mode": "contain"
          },
          "style": {
            "pointerEvents": "none"
          }
        },
        "position": {
          "basis": "0px",
          "grow": 1,
          "shrink": 1
        },
        "propConfig": {
          "props.source": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.source"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Tag"
        },
        "props": {
          "text": "",
          "style": {
            "classes": "Separator/DeviceTag"
          }
        },
        "position": {
          "shrink": 0,
          "basis": "auto"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.tag"
              }
            }
          }
        }
      }
    ],
    "position": {
      "shrink": 0
    },
    "propConfig": {
      "props.style.borderColor": {
        "binding": {
          "type": "expr",
          "config": {
            "expression": "if({view.params.highlight}, \"#f0a128\", \"transparent\")"
          }
        }
      }
    },
    "events": {
      "dom": {
        "onClick": {
          "type": "script",
          "scope": "G",
          "config": {
            "script": "\tapplication.demo.showSeparatorDetail(self.view.params.tag, self.view.params.signal)"
          }
        }
      }
    }
  }
}
