{
  "custom": {},
  "params": {
    "signal": "level",
    "colour": "#81888d",
    "sp": 47.3
  },
  "propConfig": {
    "params.signal": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.colour": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.sp": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
