    },
    "children": [
      {
        "type": "ia.display.image",
        "meta": {
          "name": "Plot"
        },
        "props": {
          "source": "data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIyODAiIGhlaWdodD0iNzAiIHZpZXdCb3g9IjAgMCAyODAgNzAiPjwvc3ZnPg==",
          "fit": {
            "mode": "fill"
          },
          "style": {
            "pointerEvents": "none"
          }
        },
        "position": {
          "x": 0,
          "y": 0,
          "width": 1,
          "height": 1
        },
        "propConfig": {
          "props.source": {
            "binding": {
              "type": "expr-struct",
