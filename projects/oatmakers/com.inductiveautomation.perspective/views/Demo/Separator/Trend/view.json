              },
              "transforms": [
                {
                  "type": "script",
                  "code": "\treturn application.demo.separatorTrendSvg(value[\"signal\"], value[\"colour\"], value[\"sp\"])"
                }
              ]
            }
          }
        }
      }
    ],
    "position": {
      "shrink": 0
    }
