{
  "custom": {},
  "params": {
    "tag": "PI152A",
    "signal": "pressure"
  },
  "propConfig": {
    "params.tag": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.signal": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 1280,
      "height": 300
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "Demo/PopupRoot"
      }
    },
    "children": [
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Title"
        },
        "props": {
          "text": "",
          "style": {
            "classes": "Demo/SectionTitle"
          }
        },
        "position": {
          "shrink": 0,
          "basis": "auto"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.tag"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Mode"
        },
        "props": {
          "text": "Read-only process simulation",
          "style": {
            "classes": "Demo/Muted"
          }
        },
        "position": {
          "shrink": 0,
          "basis": "auto"
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Value"
        },
        "props": {
          "text": "",
          "style": {
            "classes": "Separator/DetailValue"
          }
        },
        "position": {
          "shrink": 0,
          "basis": "auto"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr-struct",
              "config": {
                "waitOnAll": true,
                "struct": {
                  "tick": "now(1000)",
                  "signal": "{view.params.signal}"
                }
              },
              "transforms": [
                {
                  "type": "script",
                  "code": "\treturn application.demo.separatorDetailValue(value[\"signal\"])"
                }
              ]
            }
          }
        }
      },
      {
        "type": "ia.display.view",
        "meta": {
          "name": "Trend"
        },
        "props": {
          "path": "Demo/Separator/Trend",
          "params": {
            "colour": "#626b75",
            "sp": 0
          },
          "useDefaultViewWidth": false,
          "useDefaultViewHeight": false
        },
        "position": {
          "shrink": 0,
          "basis": "160px"
        },
        "propConfig": {
          "props.params.signal": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.signal"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Caption"
        },
        "props": {
          "text": "Last hour of simulated process history",
          "style": {
            "classes": "Demo/Muted"
          }
        },
        "position": {
          "shrink": 0,
          "basis": "auto"
        }
      }
    ],
    "position": {
      "shrink": 0
    }
  }
}
