{
  "custom": {
    "value": 0,
    "lastUpdate": 0,
    "fresh": false
  },
  "params": {
    "lineNumber": 1,
    "metric": "temperature",
    "tag": "Temperature",
    "label": "Temperature",
    "unit": "\u00b0C"
  },
  "propConfig": {
    "custom.value": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "[default]OatmakersDemo/Line{line}/{tag}",
          "references": {
            "line": "{view.params.lineNumber}",
            "tag": "{view.params.tag}"
          }
        }
      }
    },
    "custom.lastUpdate": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "[default]OatmakersDemo/Line{line}/LastUpdate",
          "references": {
            "line": "{view.params.lineNumber}"
          }
        }
      }
    },
    "custom.fresh": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "dateDiff({view.custom.lastUpdate}, now(1000), \"second\") < 30"
        }
      }
    },
    "params.lineNumber": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.metric": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tag": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.label": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.unit": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 1280,
      "height": 60
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "Demo/TagFace"
      }
    },
    "children": [
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Name"
        },
        "props": {
          "text": "",
          "style": {
            "classes": "Demo/TagName"
          }
        },
        "position": {
          "shrink": 0,
          "basis": "auto"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.label"
              }
            }
          }
        }
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Reading"
        },
        "props": {
          "direction": "row",
          "style": {
            "classes": "Demo/MetricReading"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Value"
            },
            "props": {
              "text": "",
              "style": {
                "classes": "Demo/TagValue"
              }
            },
            "position": {
              "shrink": 0,
              "basis": "auto"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if({view.custom.fresh}, numberFormat({view.custom.value}, \"#,##0.0\"), \"n/a\")"
                  }
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Unit"
            },
            "props": {
              "text": "",
              "style": {
                "classes": "Demo/TagUnit"
              }
            },
            "position": {
              "shrink": 0,
              "basis": "auto"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "property",
                  "config": {
                    "path": "view.params.unit"
                  }
                }
              }
            }
          }
        ],
        "position": {
          "shrink": 0
        }
      }
    ],
    "position": {
      "shrink": 0
    },
    "events": {
      "dom": {
        "onClick": {
          "type": "script",
          "scope": "G",
          "config": {
            "script": "\tapplication.demo.showHistory(self.view.params.lineNumber, self.view.params.metric)"
          }
        }
      }
    }
  }
}
