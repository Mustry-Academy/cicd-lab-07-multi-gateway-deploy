{
  "custom": {
    "batches": [],
    "selected": ""
  },
  "params": {},
  "propConfig": {
    "custom.batches": {
      "binding": {
        "type": "expr-struct",
        "config": {
          "waitOnAll": true,
          "struct": {
            "start": "{/root/QualityFilters/QualityRange.props.output.startEpochMs}",
            "end": "{/root/QualityFilters/QualityRange.props.output.endEpochMs}",
            "refresh": "now(10000)"
          }
        },
        "transforms": [
          {
            "type": "script",
            "code": "\treturn application.demo.batches(value[\"start\"], value[\"end\"])"
          }
        ]
      }
    },
    "custom.selected": {
      "binding": {
        "type": "property",
        "config": {
          "path": "/root/BatchGrid.props.state.selection"
        },
        "transforms": [
          {
            "type": "script",
            "code": "\treturn str(value[0]) if value else \"\""
          }
        ]
      }
    }
  },
  "props": {
    "defaultSize": {
      "width": 1280,
      "height": 1000
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "Demo/Page"
      }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Header"
        },
        "props": {
          "direction": "row",
          "wrap": "wrap",
          "style": {
            "classes": "Demo/PageHeader"
          }
        },
        "children": [
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "Identity"
            },
            "props": {
              "direction": "column"
            },
            "children": [
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "Eyebrow"
                },
                "props": {
                  "text": "OATMAKERS / LIVE OPERATIONS",
                  "style": {
                    "classes": "Demo/Eyebrow"
                  }
                },
                "position": {
                  "shrink": 0,
                  "basis": "auto"
                }
              },
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "Title"
                },
                "props": {
                  "text": "Quality & traceability",
                  "style": {
                    "classes": "Demo/PageTitle"
                  }
                },
                "position": {
                  "shrink": 0,
                  "basis": "auto"
                }
              },
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "Subtitle"
                },
                "props": {
                  "text": "Find a production batch and inspect its measurements.",
                  "style": {
                    "classes": "Demo/Subtitle"
                  }
                },
                "position": {
                  "shrink": 0,
                  "basis": "auto"
                }
              }
            ],
            "position": {
              "shrink": 0,
              "grow": 1
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Mode"
            },
            "props": {
              "text": "SIMULATED FACTORY",
              "style": {
                "classes": "Demo/DemoBadge"
              }
            },
            "position": {
              "shrink": 0,
              "basis": "auto"
            }
          }
        ],
        "position": {
          "shrink": 0
        }
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "QualityFilters"
        },
        "props": {
          "direction": "row",
          "wrap": "wrap",
          "style": {
            "classes": "Demo/Filters"
          }
        },
        "children": [
          {
            "type": "mustrysolutions.perspective.input.datetimerangepicker",
            "meta": {
              "name": "QualityRange"
            },
            "props": {
              "config": {
                "display": "popover",
                "layout": "twoMonths",
                "granularity": "second",
                "timezone": "Europe/Brussels",
                "locale": "en-GB",
                "disableDates": "future",
                "spanDays": {
                  "max": 90
                },
                "showPresets": true,
                "showClear": false,
                "popover": {
                  "placeholder": "Choose history range",
                  "closeOnSelect": true,
                  "dateFormat": "DD/MM/YYYY"
                },
                "presets": [
                  {
                    "label": "Last 15 min",
                    "type": "rolling",
                    "rolling": {
                      "amount": 0.25,
                      "unit": "hours"
                    }
                  },
                  {
                    "label": "Last hour",
                    "type": "rolling",
                    "rolling": {
                      "amount": 1,
                      "unit": "hours"
                    }
                  },
                  {
                    "label": "Last 8 hours",
                    "type": "rolling",
                    "rolling": {
                      "amount": 8,
                      "unit": "hours"
                    }
                  },
                  {
                    "label": "Last 24 hours",
                    "type": "rolling",
                    "rolling": {
                      "amount": 24,
                      "unit": "hours"
                    }
                  },
                  {
                    "label": "Last 7 days",
                    "type": "rolling",
                    "rolling": {
                      "amount": 7,
                      "unit": "days"
                    }
                  },
                  {
                    "label": "Last 30 days",
                    "type": "rolling",
                    "rolling": {
                      "amount": 30,
                      "unit": "days"
                    }
                  }
                ],
                "realtime": {
                  "enabled": true,
                  "refreshSeconds": 5
                }
              },
              "selection": {
                "rollingAmount": 24,
                "rollingUnit": "hours"
              },
              "style": {
                "overflow": "visible",
                "classes": "Demo/DateRange",
                "height": "40px"
              },
              "output": {
                "startDateTime": "",
                "endDateTime": "",
                "startEpochMs": 0,
                "endEpochMs": 0,
                "durationDays": 0,
                "durationHours": 0,
                "durationLabel": "",
                "isValid": false,
                "isRealtime": false
              }
            },
            "position": {
              "shrink": 0,
              "basis": "390px"
            },
            "propConfig": {
              "props.output": {
                "persistent": true
              },
              "props.config.dateBounds.earliest": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "dateFormat(addDays(now(60000), -90), \"yyyy-MM-dd\")"
                  }
                }
              }
            }
          },
          {
            "type": "ia.input.button",
            "meta": {
              "name": "InspectBatch"
            },
            "props": {
              "text": "Inspect selected batch",
              "style": {
                "classes": "Demo/Button",
                "height": "40px",
                "minWidth": "180px",
                "whiteSpace": "nowrap"
              }
            },
            "position": {
              "basis": "auto",
              "grow": 0,
              "shrink": 0
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\tapplication.demo.showBatch(self.view.custom.selected)"
                  }
                }
              }
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "len({view.custom.selected}) > 0"
                  }
                }
              }
            }
          }
        ],
        "position": {
          "shrink": 0
        }
      },
      {
        "type": "mustrysolutions.perspective.input.datagrid",
        "meta": {
          "name": "BatchGrid"
        },
        "props": {
          "config": {
            "columns": [
              {
                "field": "reference",
                "header": "Batch",
                "width": 190
              },
              {
                "field": "product",
                "header": "Product",
                "width": 160
              },
              {
                "field": "line",
                "header": "Line",
                "width": 170
              },
              {
                "field": "good_kg",
                "header": "Good output kg",
                "width": 150,
                "type": "number",
                "align": "right",
                "decimals": 1
              },
              {
                "field": "quality",
                "header": "Quality decision",
                "width": 170,
                "cellStyles": [
                  {
                    "equals": "Scheduled",
                    "color": "#5d666e",
                    "background": "#eef1f3"
                  },
                  {
                    "equals": "In production",
                    "color": "#23282d",
                    "background": "#e2e6e9"
                  },
                  {
                    "equals": "Completed",
                    "color": "#5d666e",
                    "background": "#f1f3f5"
                  },
                  {
                    "equals": "Quality review",
                    "color": "#b57a17",
                    "background": "#fdf3e0"
                  },
                  {
                    "equals": "Review required",
                    "color": "#b57a17",
                    "background": "#fdf3e0"
                  },
                  {
                    "equals": "Stopped",
                    "color": "#b23b34",
                    "background": "#fbeceb"
                  },
                  {
                    "equals": "Released",
                    "color": "#3f4a54",
                    "background": "#eef1f3"
                  },
                  {
                    "equals": "Within limits",
                    "color": "#3f4a54",
                    "background": "#eef1f3"
                  }
                ]
              }
            ],
            "idField": "reference",
            "rowHeight": 44,
            "locale": "en-GB",
            "rowSelect": "single",
            "showToolbar": true,
            "showExport": true,
            "editable": false,
            "emptyMessage": "No records for the selected range."
          },
          "data": {
            "rows": []
          },
          "state": {
            "selection": []
          },
          "style": {
            "classes": "Demo/DataGrid"
          }
        },
        "position": {
          "shrink": 0,
          "basis": "480px"
        },
        "propConfig": {
          "props.data.rows": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.custom.batches"
              }
            }
          }
        }
      }
    ],
    "position": {
      "shrink": 0
    }
  }
}
